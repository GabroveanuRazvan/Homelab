[Unit]
Description=TigerVNC homelab desktop on display :{{ vnc_display }}
After=network.target

[Service]
Type=simple
User={{ primary_user }}
Group={{ primary_user }}
WorkingDirectory={{ primary_user_home }}
Environment=HOME={{ primary_user_home }}
ExecStart=/usr/bin/tigervncserver :{{ vnc_display }} -fg -geometry {{ vnc_geometry }} -depth {{ vnc_depth }} -localhost {{ 'yes' if vnc_localhost_only else 'no' }} -PasswordFile {{ primary_user_home }}/.vnc/passwd -xstartup {{ primary_user_home }}/.vnc/xstartup
KillMode=mixed
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
